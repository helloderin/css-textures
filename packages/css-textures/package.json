{
  "name": "css-textures",
  "version": "0.1.0",
  "description": "A zero-dependency palette of CSS textures",
  "keywords": [
    "css",
    "texture",
    "background",
    "design",
    "ui"
  ],
  "author": "helloderin",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.20.2"
  }
}
