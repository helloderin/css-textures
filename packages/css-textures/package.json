{
  "name": "css-textures",
  "version": "0.2.0",
  "description": "A zero-dependency palette of CSS textures",
  "keywords": [
    "css",
    "texture",
    "background",
    "design",
    "ui"
  ],
  "author": "helloderin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/helloderin/css-textures.git"
  },
  "homepage": "https://github.com/helloderin/css-textures#readme",
  "bugs": {
    "url": "https://github.com/helloderin/css-textures/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./index.d.ts"
    },
    "./react": {
      "types": "./react.d.ts"
    },
    "./css": "./dist/textures.css",
    "./css/leather": "./dist/textures/leather.css"
  },
  "files": [
    "dist",
    "README.md",
    "react.d.ts"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "jsdom": "^25.0.0",
    "vitest": "^2.0.0"
  }
}
